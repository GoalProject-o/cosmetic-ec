"use client"

import { useEffect, useState, useMemo, useCallback } from 'react'
import { DashboardStats, CategorySalesData, ShippingAnalysis } from '@/types/analytics'
import { DummyDataGenerator } from '@/lib/analytics/dummyDataGenerator'
import { SalesLineChart } from '@/components/charts/SalesLineChart'
import { CategoryPieChart } from '@/components/charts/CategoryPieChart'
import { ProductBarChart } from '@/components/charts/ProductBarChart'
import { ShippingAnalysisChart } from '@/components/charts/ShippingAnalysisChart'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { LoadingSkeleton } from '@/components/ui/loading-spinner'
import { TrendingUp, ShoppingCart, Package, AlertTriangle } from 'lucide-react'

export default function DashboardPage() {
  const [dashboardStats, setDashboardStats] = useState<DashboardStats | null>(null)
  const [categoryData, setCategoryData] = useState<CategorySalesData[]>([])
  const [shippingData, setShippingData] = useState<ShippingAnalysis[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)

  const loadData = useCallback(async () => {
    try {
      setError(null)
      const stats = DummyDataGenerator.generateDashboardStats()
      const categories = DummyDataGenerator.generateCategorySalesData()
      const shipping = DummyDataGenerator.generateShippingAnalysis()
      
      setDashboardStats(stats)
      setCategoryData(categories)
      setShippingData(shipping)
    } catch (error) {
      console.error('データの読み込みに失敗しました:', error)
      setError('データの読み込みに失敗しました。再読み込みしてください。')
    } finally {
      setLoading(false)
    }
  }, [])

  useEffect(() => {
    loadData()
  }, [loadData])

  if (loading) {
    return (
      <div className="p-4 sm:p-6">
        <LoadingSkeleton />
      </div>
    )
  }

  if (error) {
    return (
      <div className="p-6">
        <div className="text-center">
          <div className="text-red-600 mb-4">{error}</div>
          <button 
            onClick={loadData}
            className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
          >
            再読み込み
          </button>
        </div>
      </div>
    )
  }

  if (!dashboardStats) {
    return (
      <div className="p-6">
        <div className="text-center text-red-600">
          データが見つかりません
        </div>
      </div>
    )
  }

  const formatCurrency = useMemo(() => 
    (value: number) => `¥${value.toLocaleString()}`, []
  )

  return (
    <div className="p-4 sm:p-6 space-y-4 sm:space-y-6">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <h1 className="text-2xl sm:text-3xl font-bold" role="banner">管理者ダッシュボード</h1>
        <div className="text-sm text-gray-500">
          最終更新: {new Date().toLocaleString('ja-JP')}
        </div>
      </div>

      {/* 概要統計 */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">総売上</CardTitle>
            <TrendingUp className="h-4 w-4 text-green-600" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{formatCurrency(dashboardStats.totalSales)}</div>
            <p className="text-xs text-green-600 mt-1">
              過去30日間
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">総注文数</CardTitle>
            <ShoppingCart className="h-4 w-4 text-blue-600" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{dashboardStats.totalOrders.toLocaleString()}</div>
            <p className="text-xs text-blue-600 mt-1">
              件の注文
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">商品数</CardTitle>
            <Package className="h-4 w-4 text-purple-600" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{dashboardStats.totalProducts.toLocaleString()}</div>
            <p className="text-xs text-purple-600 mt-1">
              商品登録済み
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
            <CardTitle className="text-sm font-medium">平均注文額</CardTitle>
            <TrendingUp className="h-4 w-4 text-orange-600" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{formatCurrency(dashboardStats.averageOrderValue)}</div>
            <p className="text-xs text-orange-600 mt-1">
              1注文あたり
            </p>
          </CardContent>
        </Card>
      </div>

      {/* チャートセクション */}
      <div className="grid grid-cols-1 xl:grid-cols-2 gap-4 md:gap-6">
        {/* 売上トレンド */}
        <Card>
          <CardHeader>
            <CardTitle id="sales-trend">売上トレンド（過去7日間）</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="h-64 sm:h-72 md:h-80" role="img" aria-labelledby="sales-trend">
              <SalesLineChart data={dashboardStats.salesTrend} height={undefined} />
            </div>
          </CardContent>
        </Card>

        {/* カテゴリー別売上 */}
        <Card>
          <CardHeader>
            <CardTitle id="category-sales">カテゴリー別売上</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="h-64 sm:h-72 md:h-80" role="img" aria-labelledby="category-sales">
              <CategoryPieChart data={categoryData} height={undefined} />
            </div>
          </CardContent>
        </Card>

        {/* 人気商品ランキング */}
        <Card>
          <CardHeader>
            <CardTitle>人気商品ランキング（TOP5）</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="h-64 sm:h-72 md:h-80">
              <ProductBarChart data={dashboardStats.topSellingProducts} height={undefined} />
            </div>
          </CardContent>
        </Card>

        {/* 配送分析 */}
        <Card>
          <CardHeader>
            <CardTitle>配送方法別分析</CardTitle>
          </CardHeader>
          <CardContent>
            <div className="h-64 sm:h-72 md:h-80">
              <ShippingAnalysisChart data={shippingData} height={undefined} />
            </div>
          </CardContent>
        </Card>
      </div>

      {/* 最近の注文 */}
      <Card>
        <CardHeader>
          <CardTitle>最近の注文</CardTitle>
        </CardHeader>
        <CardContent>
          <div className="space-y-3">
            {dashboardStats.recentOrders.map((order) => (
              <div key={order.id} className="flex flex-col sm:flex-row sm:items-center justify-between p-3 border rounded space-y-2 sm:space-y-0 hover:bg-gray-50 transition-colors">
                <div className="flex-1 min-w-0">
                  <div className="flex flex-wrap items-center gap-2 sm:space-x-3">
                    <div className="font-medium text-sm sm:text-base truncate">{order.orderNumber}</div>
                    <Badge variant={
                      order.status === 'delivered' ? 'default' :
                      order.status === 'shipped' ? 'secondary' :
                      order.status === 'confirmed' ? 'outline' : 'destructive'
                    }>
                      {order.status === 'delivered' ? '配送完了' :
                       order.status === 'shipped' ? '配送中' :
                       order.status === 'confirmed' ? '確認済み' : '保留中'}
                    </Badge>
                  </div>
                  <div className="text-xs sm:text-sm text-gray-600 mt-1">
                    <span className="block sm:inline">{order.customerName}</span>
                    <span className="hidden sm:inline"> • </span>
                    <span className="block sm:inline">{order.destination} • {order.items}点</span>
                  </div>
                  <div className="text-xs text-gray-500">
                    {order.createdAt.toLocaleDateString('ja-JP')}
                  </div>
                </div>
                <div className="text-right sm:text-left">
                  <div className="font-medium text-sm sm:text-base">{formatCurrency(order.amount)}</div>
                </div>
              </div>
            ))}
          </div>
        </CardContent>
      </Card>

      {/* 価格変動アラート */}
      {dashboardStats.alertItems.length > 0 && (
        <Card>
          <CardHeader>
            <CardTitle className="flex items-center space-x-2">
              <AlertTriangle className="h-5 w-5 text-yellow-600" aria-hidden="true" />
              <span>価格変動アラート</span>
            </CardTitle>
          </CardHeader>
          <CardContent>
            <div className="space-y-3">
              {dashboardStats.alertItems.map((alert) => (
                <div key={alert.id} className="flex items-start space-x-3 p-3 border rounded hover:bg-gray-50 transition-colors">
                  <AlertTriangle className={`h-4 w-4 mt-1 ${
                    alert.severity === 'high' ? 'text-red-500' :
                    alert.severity === 'medium' ? 'text-yellow-500' : 'text-blue-500'
                  }`} />
                  <div className="flex-1">
                    <div className="font-medium">{alert.productName}</div>
                    <div className="text-sm text-gray-600">{alert.message}</div>
                    <div className="text-xs text-gray-500 mt-1">
                      {alert.createdAt.toLocaleString('ja-JP')}
                    </div>
                  </div>
                  <Badge variant={
                    alert.severity === 'high' ? 'destructive' :
                    alert.severity === 'medium' ? 'secondary' : 'outline'
                  }>
                    {alert.severity === 'high' ? '高' :
                     alert.severity === 'medium' ? '中' : '低'}
                  </Badge>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>
      )}
    </div>
  )
}